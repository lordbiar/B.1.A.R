/**
 * BIAR Protocol - WebSocket client with auto-reconnect and event routing.
 */
class WebSocketClient {
  constructor() {
    this.connections = new Map(); // key -> WebSocket
    this.listeners = new Map();   // key -> Set<fn>
    this.reconnectAttempts = new Map();
    this.maxReconnectAttempts = 5;
    this.pingIntervals = new Map();
  }

  _wsBase() {
    const base = window.location.hostname === 'localhost'
      ? 'ws://localhost:8000'
      : `${window.location.protocol === 'https:' ? 'wss' : 'ws'}://${window.location.host}`;
    return base;
  }

  _connect(key, path) {
    if (this.connections.has(key) && this.connections.get(key).readyState <= 1) {
      return; // already connected or connecting
    }

    const ws = new WebSocket(`${this._wsBase()}${path}`);
    this.connections.set(key, ws);

    ws.onopen = () => {
      this.reconnectAttempts.set(key, 0);
      this._setWsStatus(true);
      // Keep-alive ping every 30s
      const interval = setInterval(() => {
        if (ws.readyState === WebSocket.OPEN) ws.send('ping');
      }, 30000);
      this.pingIntervals.set(key, interval);
    };

    ws.onmessage = (event) => {
      try {
        const data = JSON.parse(event.data);
        this._emit(key, data);
        this._emit('*', data); // global listeners
      } catch (e) {
        // ignore non-JSON (pong)
      }
    };

    ws.onclose = () => {
      this._clearPing(key);
      this.connections.delete(key);
      this._setWsStatus(false);
      this._reconnect(key, path);
    };

    ws.onerror = () => ws.close();
  }

  _reconnect(key, path) {
    const attempts = (this.reconnectAttempts.get(key) || 0) + 1;
    if (attempts > this.maxReconnectAttempts) return;
    this.reconnectAttempts.set(key, attempts);
    // Exponential backoff: 1s, 2s, 4s, 8s, 16s
    setTimeout(() => this._connect(key, path), Math.min(1000 * 2 ** (attempts - 1), 16000));
  }

  _clearPing(key) {
    const interval = this.pingIntervals.get(key);
    if (interval) {
      clearInterval(interval);
      this.pingIntervals.delete(key);
    }
  }

  _emit(key, data) {
    const listeners = this.listeners.get(key);
    if (listeners) listeners.forEach((fn) => fn(data));
  }

  subscribe(key, callback) {
    if (!this.listeners.has(key)) this.listeners.set(key, new Set());
    this.listeners.get(key).add(callback);
    return () => this.listeners.get(key).delete(callback);
  }

  connectToMarket(marketId) {
    this._connect(`market:${marketId}`, `/ws/market/${encodeURIComponent(marketId)}`);
  }

  connectToFeed() {
    this._connect('feed', '/ws/feed');
  }

  _setWsStatus(connected) {
    const el = document.getElementById('wsStatus');
    if (!el) return;
    const dot = el.querySelector('span');
    const text = el.childNodes[el.childNodes.length - 1];
    if (connected) {
      if (dot) dot.className = 'w-2 h-2 bg-green-400 rounded-full animate-pulse';
      if (text) text.textContent = ' LIVE';
    } else {
      if (dot) dot.className = 'w-2 h-2 bg-gray-400 rounded-full';
      if (text) text.textContent = ' Connecting...';
    }
  }
}

const wsClient = new WebSocketClient();